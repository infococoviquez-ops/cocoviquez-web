{
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/fr", "destination": "/fr/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/cocina", "destination": "/index.html" },
    { "source": "/cocina/:path*", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/reset-password/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://ojyfdfhtuesapjebskwt.supabase.co wss://ojyfdfhtuesapjebskwt.supabase.co https://api.formspree.io https://resend.com; frame-src https://www.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self';" }
      ]
    }
  ]
}
